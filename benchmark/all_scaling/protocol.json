{
  "schema": "mr-shortcut-all-scaling-v1",
  "status": "prepared-not-run",
  "purpose": "Five-method offline comparison on every retained robot/task-count scaling experiment with one initial path and two shortcut seeds",
  "execution": "strictly_serial",
  "certificate_failure_policy": "record_failed_replicate_and_continue_without_retry",
  "pythonhashseed": 0,
  "path_indices": [0],
  "shortcut_seeds": [0, 1],
  "expected_case_counts": {
    "isolated_box_stacking": 9,
    "disk_scaling": 6,
    "coupled_box_stacking": 5,
    "mobile_wall_scaling": 49
  },
  "cost": {
    "per_robot_metric": "euclidean",
    "implementation_metric": "euclidean",
    "implementation_reduction": "max",
    "regularization_weight": 0.01,
    "edge_formula": "max_r ||q_(i+1)^r-q_i^r||_2 + 0.01 sum_r ||q_(i+1)^r-q_i^r||_2",
    "path_reduction": "sum_over_edges"
  },
  "methods": [
    {
      "id": "tree_gain",
      "label": "tree + gain (standard)",
      "policy": "tree_prefix"
    },
    {
      "id": "full_tree_gain_round_robin",
      "label": "full/tree/gain round robin",
      "policy": "full_tree_gain_round_robin"
    },
    {
      "id": "scalable_tree_group",
      "label": "scalable tree + group",
      "policy": "scalable_tree_group"
    },
    {
      "id": "robot_subset_mode",
      "label": "random robot subset + compatible run",
      "policy": "robot_subset_mode"
    },
    {
      "id": "full_configuration",
      "label": "full configuration",
      "policy": "full_configuration"
    }
  ],
  "case_grids": [
    {
      "id_format": "rai-isolated-box-stacking-r{num_robots}-b4",
      "axes": {"num_robots": [1, 2, 3, 4, 5, 6]},
      "case": {
        "family": "isolated_box_stacking",
        "constructor": "rai_isolated_arm_box_stack_env",
        "environment_kwargs": {"num_boxes": 4},
        "environment_seed": 0,
        "seconds": 30,
        "input_root": "benchmark/expanded/inputs"
      }
    },
    {
      "id_format": "rai-isolated-box-stacking-r{num_robots}-b4",
      "axes": {"num_robots": [7, 8, 9]},
      "case": {
        "family": "isolated_box_stacking",
        "constructor": "rai_isolated_arm_box_stack_env",
        "environment_kwargs": {"num_boxes": 4},
        "environment_seed": 0,
        "seconds": 30,
        "input_root": "benchmark/scaling_mobile_wall/inputs"
      }
    },
    {
      "id_format": "rai-disk-scaling-r{num_robots}-g4",
      "axes": {"num_robots": [2, 4, 6, 8, 10, 12]},
      "case": {
        "family": "disk_scaling",
        "constructor": "rai_disk_scaling",
