        "environment_kwargs": {"num_boxes": 8, "environment_seed": 10},
        "environment_seed": 10,
        "seconds": 30,
        "input_root": "benchmark/scalable_study/inputs"
      }
    },
    {
      "id_format": "rai-mobile-wall-scaling-r{num_robots}-x{wall_x}-z{wall_z}",
      "axes": {
        "num_robots": [1, 2, 3, 4, 5, 6, 7],
