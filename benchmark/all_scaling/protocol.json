    "benchmark/scalable_study/offline/results",
    "benchmark/expanded/offline/results",
    "benchmark/scaling_2d/offline/results"
  ],
  "offline": {
    "interpolation_resolution": 0.5,
    "budget_type": "shortcut_wall_clock_seconds",
    "timer_excludes": [
