{
  "schema": "mr-shortcut-final-protocol-v1",
  "status": "frozen-no-results",
  "frozen_on": "2026-09-30",
  "purpose": "Final offline and planning-in-the-loop comparison for the multi-robot shortcutting article.",
  "cost": {
    "per_robot_metric": "euclidean",
    "implementation_metric": "euclidean",
    "implementation_reduction": "max",
    "regularization_weight": 0.01,
    "edge_formula": "max_r ||q_(i+1)^r-q_i^r||_2 + 0.01 sum_r ||q_(i+1)^r-q_i^r||_2",
    "path_reduction": "sum_over_edges"
  },
  "design": {
    "path_indices": [
      0,
      1,
      2
    ],
    "shortcut_seeds": [
      0,
      1,
      2
    ],
    "cross_product": true,
    "execution": "strictly_serial",
    "aggregation": {
      "within_path": "pointwise_median_over_shortcut_seeds",
      "across_paths": "pointwise_median_over_initial_paths",
      "uncertainty": "minimum_to_maximum_across_path_medians",
      "weighting": "each_initial_path_has_equal_weight"
    }
  },
  "rng": {
    "pythonhashseed": 0,
    "environment_seed_source": "benchmark/manifest.json",
    "planner_seed_rule": "environment_seed + path_index",
    "shortcut_seed_rule": "shortcut_seeds entry",
    "online_call_seed_rule": "shortcut_seed + 104729 * shortcut_call_index",
    "online_shortcut_rng_isolated_from_planner": true
  },
  "methods": [
    {
      "id": "single_robot_mode",
      "label": "random robot + compatible run",
      "offline_policy": "single_robot_mode",
      "online_policy": "single_robot_mode"
    },
    {
      "id": "robot_subset_mode",
      "label": "random robot subset + compatible run",
      "offline_policy": "robot_subset_mode",
      "online_policy": "robot_subset_mode"
    },
    {
      "id": "huang_round_robin_no_prioritized",
      "label": "Huang round robin, no priority",
      "offline_policy": "huang_round_robin_no_prioritized",
      "online_policy": "huang_round_robin_no_prioritized"
    },
    {
      "id": "tree_gain",
      "label": "tree + gain (standard)",
      "offline_policy": "tree_prefix",
      "online_policy": "upstream_tree"
    },
    {
      "id": "tree_group_gain",
      "label": "tree + group gain",
      "offline_policy": "tree_group_gain",
      "online_policy": "tree_group_gain"
    },
    {
      "id": "gain_only",
      "label": "gain only",
      "offline_policy": "gain_only",
      "online_policy": "gain_only"
    },
    {
      "id": "full_tree_gain_round_robin",
      "label": "full/tree/gain round robin",
      "offline_policy": "full_tree_gain_round_robin",
      "online_policy": "full_tree_gain_round_robin"
    }
  ],
  "offline": {
    "interpolation_resolution": 0.5,
    "budget_type": "shortcut_wall_clock_seconds",
    "timer_excludes": [
      "environment_construction",
      "input_restoration_and_certificate",
      "final_certificate"
    ]
  },
  "online": {
    "planner": "BidirectionalRRTstar",
    "optimize": true,
    "shortcut_checks_per_call": 250,
    "planner_default_shortcut_checks_per_call": 100,
    "refinement_seconds_after_first_solution": 100,
    "replay_margin_seconds": 15,
    "runtime_rule": "ceil(saved_first_solution_wall_seconds) + refinement_seconds_after_first_solution + replay_margin_seconds",
    "analysis_time_origin": "first_solution",
    "analysis_horizon_seconds": 100,
    "include_planner_only_control": true,
    "planner_only_repetitions": "once_per_initial_path",
    "no_uncharged_final_shortcut_pass": true
  },
  "cases": [
    {
      "id": "rai-random-2d",
      "input_generation_seconds": 500,
