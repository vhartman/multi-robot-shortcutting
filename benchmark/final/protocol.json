  ],
  "validation": {
    "input": [
      "environment_fingerprint",
      "strict_full_edge_collision_certificate",
      "terminal_mode",
      "native_valid_plan_when_available"
    ],
    "offline_output": [
      "same_environment_fingerprint",
      "same_endpoints",
      "same_complete_mode_sequence",
      "terminal_mode",
      "strict_full_edge_collision_certificate",
      "native_valid_plan_when_available"
    ],
    "online_output": [
      "same_environment_fingerprint",
      "same_planner_seed_as_saved_input",
      "same_first_solution_cost_as_saved_input",
      "at_least_100_seconds_after_first_solution",
      "terminal_mode",
      "strict_full_edge_collision_certificate",
      "native_valid_plan_when_available"
    ],
    "failed_cell_policy": "Never replace a failed seed or path. Preserve its log, record it as missing, and rerun only the identical cell after fixing an infrastructure failure."
  },
  "software": {
    "python": "3.10.12",
    "mr_bench_revision": "3142dacfbfc22d619f52d69d07164eacae21b26c",
    "mr_bench_note": "This is the clean tracked revision used by the latest experiments; publish this commit or an equivalent tagged revision before public release.",
    "assembly_revisions_are_case_specific": true,
    "dependency_file": "pyproject.toml",
    "content_lock": "benchmark/final/protocol.lock.json"
  },
  "outputs": {
    "inputs": "inputs/<case>/path<path_index>.json",
    "offline": "offline/results/<case>/<method>-path<path_index>-seed<shortcut_seed>.json",
    "online": "online/results/<case>/<method>-path<path_index>-seed<shortcut_seed>.json",
    "planner_only": "online/results/<case>/planner_only-path<path_index>.json",
    "logs": "<phase>/logs/<case>/...",
    "summary": "analysis/summary.json"
  }
}
